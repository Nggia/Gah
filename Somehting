                Title.BackgroundTransparency = 1
                Title.Position = UDim2.new(0.05, 0, 0, 0)
                Title.Size = UDim2.new(0, 140, 0, 15)
                Title.Font = Enum.Font.GothamBold
                Title.Text = tostring(text)
                Title.TextColor3 = Color3.fromRGB(155, 155, 155)
                Title.TextSize = 11.000
                Title.TextXAlignment = Enum.TextXAlignment.Center

                local BoxFrame = Instance.new("Frame", TextFrame)
                BoxFrame.BackgroundColor3 = Color3.fromRGB(18, 18, 18)
                BoxFrame.Position = UDim2.new(0.05, 0, 0.4, 0)
                BoxFrame.Size = UDim2.new(0, 140, 0, 20)
                Instance.new("UICorner", BoxFrame).CornerRadius = UDim.new(0, 4)

                local TBox = Instance.new("TextBox", BoxFrame)
                TBox.BackgroundTransparency = 1
                TBox.Size = UDim2.new(1, 0, 1, 0)
                TBox.Font = Enum.Font.GothamSemibold
                TBox.PlaceholderText = placeholder
                TBox.PlaceholderColor3 = Color3.fromRGB(100, 100, 100)
                TBox.Text = ""
                TBox.TextColor3 = Color3.fromRGB(200, 200, 200)
                TBox.TextSize = 11.000

                TBox.FocusLost:Connect(function()
                    if #TBox.Text > 0 then
                        pcall(callback, TBox.Text)
                    end
                end)
            end

            function items:Label(text, imageId)
                local LblFrame = Instance.new("Frame", ScrollingFrame_Pageframe)
                LblFrame.BackgroundTransparency = 1
                LblFrame.Size = UDim2.new(0, 150, 0, 20)

                local LblText = Instance.new("TextLabel", LblFrame)
                LblText.BackgroundTransparency = 1
                LblText.Size = UDim2.new(1, 0, 1, 0)
                LblText.Font = Enum.Font.GothamSemibold
                LblText.Text = text
                LblText.TextColor3 = Color3.fromRGB(255, 255, 255)
                LblText.TextSize = 11.000
                LblText.TextXAlignment = Enum.TextXAlignment.Center

                if imageId then
                    local Icon = Instance.new("ImageLabel", LblFrame)
                    Icon.BackgroundTransparency = 1
                    Icon.Position = UDim2.new(0.05, 0, 0.1, 0)
                    Icon.Size = UDim2.new(0, 16, 0, 16)
                    Icon.Image = "http://www.roblox.com/asset/?id="..tostring(imageId)
                end
                
                local lblSystem = {}
                function lblSystem:Change(newText)
                    LblText.Text = newText
                end
                return lblSystem
            end

            function items:Line()
                local Line = Instance.new("Frame", ScrollingFrame_Pageframe)
                Line.BackgroundColor3 = Color3.fromRGB(60, 60, 60)
                Line.BorderSizePixel = 0
                Line.Size = UDim2.new(0, 150, 0, 1)
            end

            return items
        end
        return page
    end
    return top
end
