ui = game:GetService("CoreGui"):FindFirstChild("redui")
if ui then ui:Destroy() end

UserInputService = game:GetService("UserInputService")
TweenService = game:GetService("TweenService")

screen = Instance.new("ScreenGui",game.CoreGui)
screen.Name = "redui"

function drag(top,obj)
dragging=false
top.InputBegan:Connect(function(i)
if i.UserInputType==Enum.UserInputType.MouseButton1 then
dragging=true
start=i.Position
pos=obj.Position
i.Changed:Connect(function()
if i.UserInputState==Enum.UserInputState.End then dragging=false end
end)
end
end)

UserInputService.InputChanged:Connect(function(i)
if dragging and i.UserInputType==Enum.UserInputType.MouseMovement then
delta=i.Position-start
obj.Position=UDim2.new(pos.X.Scale,pos.X.Offset+delta.X,pos.Y.Scale,pos.Y.Offset+delta.Y)
end
end)
end

lib={}
function lib:Create(title)

Main=Instance.new("Frame",screen)
Main.Size=UDim2.new(0,420,0,360)
Main.Position=UDim2.new(0.5,-210,0.5,-180)
Main.BackgroundColor3=Color3.fromRGB(20,20,20)
Main.BorderSizePixel=0
Instance.new("UICorner",Main)

Top=Instance.new("Frame",Main)
Top.Size=UDim2.new(1,0,0,30)
Top.BackgroundTransparency=1

drag(Top,Main)

Title=Instance.new("TextLabel",Main)
Title.Size=UDim2.new(1,0,0,30)
Title.BackgroundTransparency=1
Title.Text=title
Title.TextColor3=Color3.fromRGB(200,200,200)
Title.Font=Enum.Font.GothamBold
Title.TextSize=14

TabHolder=Instance.new("Frame",Main)
TabHolder.Size=UDim2.new(0,100,1,-30)
TabHolder.Position=UDim2.new(0,0,0,30)
TabHolder.BackgroundColor3=Color3.fromRGB(25,25,25)

Pages=Instance.new("Frame",Main)
Pages.Size=UDim2.new(1,-100,1,-30)
Pages.Position=UDim2.new(0,100,0,30)
Pages.BackgroundColor3=Color3.fromRGB(30,30,30)

tablib={}

function tablib:Tab(name)
btn=Instance.new("TextButton",TabHolder)
btn.Size=UDim2.new(1,0,0,30)
btn.Text=name
btn.BackgroundColor3=Color3.fromRGB(35,35,35)
btn.TextColor3=Color3.fromRGB(200,200,200)
btn.Font=Enum.Font.Gotham
btn.TextSize=12

page=Instance.new("Frame",Pages)
page.Size=UDim2.new(1,0,1,0)
page.Visible=false
page.BackgroundTransparency=1

list=Instance.new("UIListLayout",page)
list.Padding=UDim.new(0,5)

btn.MouseButton1Click:Connect(function()
for _,v in pairs(Pages:GetChildren()) do
if v:IsA("Frame") then v.Visible=false end
end
page.Visible=true
end)

items={}

function items:Button(text,callback)
b=Instance.new("TextButton",page)
b.Size=UDim2.new(1,-10,0,28)
b.BackgroundColor3=Color3.fromRGB(40,40,40)
b.Text=text
b.TextColor3=Color3.fromRGB(200,200,200)
b.Font=Enum.Font.Gotham
b.TextSize=12
Instance.new("UICorner",b)
b.MouseButton1Click:Connect(callback)
end

function items:Toggle(text,def,callback)
state=def or false
f=Instance.new("Frame",page)
f.Size=UDim2.new(1,-10,0,28)
f.BackgroundColor3=Color3.fromRGB(40,40,40)
Instance.new("UICorner",f)

t=Instance.new("TextLabel",f)
t.Size=UDim2.new(0.7,0,1,0)
t.BackgroundTransparency=1
t.Text=text
t.TextColor3=Color3.fromRGB(200,200,200)
t.Font=Enum.Font.Gotham
t.TextSize=12

b=Instance.new("TextButton",f)
b.Size=UDim2.new(0,40,0,20)
b.Position=UDim2.new(1,-45,0.5,-10)
b.BackgroundColor3=state and Color3.fromRGB(120,120,120) or Color3.fromRGB(60,60,60)
b.Text=""
Instance.new("UICorner",b)

b.MouseButton1Click:Connect(function()
state=not state
b.BackgroundColor3=state and Color3.fromRGB(120,120,120) or Color3.fromRGB(60,60,60)
callback(state)
end)
end

function items:Slider(text,min,max,def,callback)
val=def or min

f=Instance.new("Frame",page)
f.Size=UDim2.new(1,-10,0,45)
f.BackgroundColor3=Color3.fromRGB(40,40,40)
Instance.new("UICorner",f)

l=Instance.new("TextLabel",f)
l.Size=UDim2.new(1,0,0,20)
l.BackgroundTransparency=1
l.Text=text..": "..val
l.TextColor3=Color3.fromRGB(200,200,200)
l.Font=Enum.Font.Gotham
l.TextSize=12

bar=Instance.new("Frame",f)
bar.Size=UDim2.new(1,-20,0,6)
bar.Position=UDim2.new(0,10,1,-15)
bar.BackgroundColor3=Color3.fromRGB(60,60,60)
Instance.new("UICorner",bar)

fill=Instance.new("Frame",bar)
fill.Size=UDim2.new((val-min)/(max-min),0,1,0)
fill.BackgroundColor3=Color3.fromRGB(120,120,120)
Instance.new("UICorner",fill)

drag=false

bar.InputBegan:Connect(function(i)
if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=true end
end)

UserInputService.InputEnded:Connect(function(i)
if i.UserInputType==Enum.UserInputType.MouseButton1 then drag=false end
end)

UserInputService.InputChanged:Connect(function(i)
if drag and i.UserInputType==Enum.UserInputType.MouseMovement then
p=(i.Position.X-bar.AbsolutePosition.X)/bar.AbsoluteSize.X
p=math.clamp(p,0,1)
val=math.floor(min+(max-min)*p)
fill.Size=UDim2.new(p,0,1,0)
l.Text=text..": "..val
callback(val)
end
end)
end

return items
end

return tablib
end

return lib
